---
import Landing from '../../layouts/Landing.astro';
import MultiSplit from '../../components/MultiSplit.astro';
import { products, kw } from '../../data/products';
const series = ['mhi-premium-zs', 'hisense-energy-pro-x', 'mhi-diamond-zsx', 'hisense-uni-pure'].map((id) => products.find((p) => p.id === id)!);
const faq = [
  { q: 'Kolik místností zvládne jeden multisplit?', a: 'Podle venkovní jednotky dvě až pět. Mitsubishi Heavy Industries i Hisense mají venkovní jednotky pro 2, 3, 4 a 5 vnitřních jednotek.' },
  { q: 'Můžou různé místnosti zároveň chladit a topit?', a: 'Ne. Všechny vnitřní jednotky jednoho multisplitu pracují ve stejném režimu, tedy buď chladí, nebo topí. Teplotu a výkon si ale každá místnost nastavuje sama.' },
  { q: 'Je multisplit levnější než samostatné klimatizace?', a: 'Pořizovací cena bývá podobná. Multisplit ušetří místo na fasádě a hodí se tam, kde je povolena jen jedna venkovní jednotka. Samostatné jednotky jsou nezávislé a při poruše jedné ostatní běží dál.' },
  { q: 'Můžu přidat vnitřní jednotku později?', a: 'Ano, pokud to venkovní jednotka kapacitou a počtem přípojek dovolí. Proto se vyplatí zvolit venkovní jednotku s rezervou a rozvody připravit při první montáži.' },
];
---
<Landing
  title="Klimatizace do více místností (multisplit)"
  description="Multisplit: jedna venkovní jednotka pro 2 až 5 místností. Mitsubishi Heavy Industries a Hisense, orientační ceny s montáží a návrh rozmístění zdarma."
  h1="Klimatizace do více místností"
  lead="Chcete příjemně v obýváku, ložnici i dětském pokoji? Stačí vybrat, jak mají jednotky v pokojích vypadat. O zbytek techniky se postará montážní firma."
  points={['2 až 5 místností s jednou venkovní jednotkou', 'Kombinace nástěnných, parapetních i skrytých jednotek', 'Každá místnost má vlastní ovládání a teplotu']}
  image="ph-family-living-room-play"
  feats={[{"i": "home", "t": "2 až 5 místností", "d": "Jedna venkovní jednotka."}, {"i": "building", "t": "Méně na fasádě", "d": "Ocení SVJ i sousedé."}, {"i": "ac", "t": "Různé typy jednotek", "d": "Nástěnné, parapetní i skryté."}, {"i": "thermo", "t": "Každý pokoj zvlášť", "d": "Vlastní teplota a ovládání."}]}
  preset="klimatizace-byt"
  crumbs={[{ name: 'Klimatizace', href: '/klimatizace/' }, { name: 'Do více místností', href: '/klimatizace/multisplit/' }]}
  series={series}
  seriesTitle="Jednotky, které se hodí do více pokojů"
  faq={faq}
  ctaTitle="Navrhneme řešení pro všechny pokoje"
>
  <MultiSplit slot="top" />
  <section class="copy">
    <div class="wrap copy__grid">
      <div>
        <h2>Jak multisplit funguje</h2>
        <p>Venkovní jednotka multisplitu má několik okruhů a ke každému se připojí jedna vnitřní jednotka. Vnitřní jednotky mohou mít různý výkon i typ: do ložnice malou tichou nástěnnou, do obýváku výkonnější, pod okno v podkroví parapetní. Venkovní jednotka podle potřeby rozděluje výkon tam, kde je zrovna potřeba.</p>
        <h3>Kdy se multisplit vyplatí</h3>
        <ul class="checks">
          <li>V bytovém domě, kde SVJ povolí jen jednu venkovní jednotku</li>
          <li>Když jsou klimatizované místnosti blízko u sebe</li>
          <li>Když chcete na fasádě co nejméně zařízení</li>
        </ul>
        <h3>Kdy raději samostatné jednotky</h3>
        <p>Pokud jsou místnosti na opačných stranách domu, vycházejí u multisplitu dlouhé trasy potrubí. Samostatné jednotky pak bývají jednodušší a nezávislé na sobě.</p>
      </div>
      <div>
        <h2>Kolik to stojí</h2>
        <p>Cena záleží na zvolených vnitřních jednotkách a délce rozvodů. Výkon vám doporučí <a href="/cena-klimatizace/">kalkulačka výkonu</a> a přesnou nabídku připraví partnerská firma po zaměření, zdarma.</p>
      </div>
    </div>
  </section>
</Landing>
