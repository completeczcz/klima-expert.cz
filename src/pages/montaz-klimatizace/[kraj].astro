---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import QuickStart from '../../components/QuickStart.astro';
import ContourMap from '../../components/ContourMap.astro';
import ProductCard from '../../components/ProductCard.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { regions, site } from '../../data/site';
import { regionContent } from '../../data/regions-content';
import { products } from '../../data/products';
import { cities } from '../../data/cities';

export function getStaticPaths() {
  return regions.map((r) => ({ params: { kraj: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const c = regionContent[r.slug];
const series = ['mhi-premium-zs', 'hisense-uni-pure', 'mhi-diamond-zsx', 'hisense-energy-pro-x', 'hisense-hi-therma-monoblok'].map((id) => products.find((p) => p.id === id)!);
const short = r.name.replace(' kraj', '').replace('Kraj ', '');
const others = regions.filter((x) => x.slug !== r.slug);
const isPraha = r.slug === 'praha';
const cityPages = cities.filter((x) => x.kraj === r.slug);
const title = isPraha ? 'Montáž klimatizace Praha – klimatizace s montáží' : `Montáž klimatizace ${r.name} – ${r.cities[0]}`;
const heroImg = ['hk-mc-kitchen','ph-couple-sofa-laughing','his-living-man','ph-senior-couple-laughing','mhi-living-shelves','ph-family-baby-floor','ph-couple-home-library','mhi-living-beige','ph-wake-up-stretch-1','his-homeoffice','ph-family-breakfast-1','mhi-bedroom-slate','ph-couple-books-laughing','mhi-living-green'][regions.findIndex((x) => x.slug === r.slug) % 14];
const faq = [
  { q: `Kolik stojí montáž klimatizace ${r.locative}?`, a: `Cena závisí na výkonu, řadě jednotky a délce potrubí. Přesnou nabídku vám ${r.locative} připraví partnerská firma po zaměření, zdarma a nezávazně.` },
  { q: `Jak rychle se mi ozvete?`, a: `Na každou poptávku ${r.locative} reagujeme ${site.responseTime}. Zaměření pak partnerská firma domluví podle vašich možností, mimo hlavní sezónu obvykle do týdne.` },
  { q: `Montujete i mimo ${r.cities[0]}?`, a: `Ano. Poptávky přijímáme z celého kraje, včetně okresů ${r.okresy.slice(0, 4).join(', ')}${r.okresy.length > 4 ? ' a dalších' : ''}.` },
];
---
<Base
  title={title}
  description={`Montáž klimatizací a tepelných čerpadel ${r.locative}: ${r.cities.slice(0, 4).join(', ')} a okolí. Mitsubishi Heavy Industries a Hisense, zaměření a nabídka zdarma.`.slice(0, 158)}
  crumbs={[{ name: 'Montáž v krajích', href: '/#kraje' }, { name: r.name, href: `/montaz-klimatizace/${r.slug}/` }]}
  schema={[{
    '@context': 'https://schema.org', '@type': 'Service', name: `Montáž klimatizace ${r.locative}`,
    provider: { '@id': 'https://klima-expert.cz/#firma' },
    areaServed: { '@type': isPraha ? 'City' : 'AdministrativeArea', name: r.name },
  }]}
>
  <section class="rh">
    <div class="rh__bg"><Img name={heroImg} alt="" sizes="100vw" eager /></div>
    <div class="wrap rh__in">
      <div>
        <h1>Montáž klimatizace {r.locative}</h1>
        <p class="lead">{c.intro} Poptávku předáme ověřené partnerské firmě, která to má k vám nejblíž.</p>
        <ul class="checks rh__pts">
          <li>Klimatizace a tepelná čerpadla Mitsubishi Heavy Industries a Hisense</li>
          <li>Zaměření a cenová nabídka zdarma</li>
          <li>Ozveme se {site.responseTime}</li>
        </ul>
      </div>
      <div><QuickStart heading={`Poptávka ${r.locative}`} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap rg">
      <div>
        <h2>Na co se {r.locative} připravit</h2>
        <h3>Bydlení a povolení</h3>
        <p>{c.housing}</p>
        <h3>Klima a výběr jednotky</h3>
        <p>{c.climate}</p>
        <h3>Náš tip</h3>
        <p>{c.tip}</p>
      </div>
      <div>
        <div class="rg__map"><ContourMap highlight={r.slug} /></div>
        <h3>Kde montujeme</h3>
        <p><strong>{isPraha ? 'Městské části' : 'Okresy'}:</strong> {r.okresy.join(', ')}</p>
        <p><strong>Města:</strong> {r.cities.join(', ')} a okolní obce</p>
        {cityPages.length > 0 && <p>{cityPages.map((x) => <a class="btn btn--ghost" style="min-height:40px;margin:0 8px 8px 0" href={`/montaz-klimatizace/${r.slug}/${x.slug}/`}>Klimatizace {x.loc}</a>)}</p>}
      </div>
    </div>
  </section>

  <section class="section section--ice">
    <div class="wrap">
      <div class="section__head">
        <h2>Co {r.locative} montujeme nejčastěji</h2>
        <p class="lead">Výběr řad, které se osvědčily do bytů i rodinných domů. Celou nabídku najdete v <a href="/produkty/">přehledu produktů</a>.</p>
      </div>
      <div class="rgrid">{series.map((s) => <div data-reveal><ProductCard s={s} /></div>)}</div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap">
      <div class="section__head"><h2>Jak to probíhá</h2></div>
      <Steps />
    </div>
  </section>

  <section class="section"><div class="wrap"><Faq items={faq} /></div></section>

  <section class="section section--ice">
    <div class="wrap">
      <h2>Montáž v dalších krajích</h2>
      <ul class="ok">{others.map((o) => <li><a href={`/montaz-klimatizace/${o.slug}/`}>{o.name}</a></li>)}</ul>
    </div>
  </section>
  <CtaBand title={`Klimatizace ${r.locative}`} />
</Base>
<style>
  .rh { position: relative; overflow: hidden; color: #fff; background: var(--night); padding: clamp(48px, 8vw, 104px) 0; }
  .rh__bg { position: absolute; inset: 0; }
  .rh__bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .rh::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14, 34, 51, 0.9), rgba(14, 34, 51, 0.5)); }
  .rh__in { position: relative; z-index: 1; }
  .rh h1 { font-size: clamp(2.2rem, 1.3rem + 3.6vw, 4.2rem); letter-spacing: -0.03em; }
  .rh .lead { color: #dbe7ed; }
  .rh :global(.checks li::before) { box-shadow: none; }
  .rgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 20px; }
  .rh__in { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .rh__pts { font-weight: 600; margin-top: 1.4em; }
  .rg { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .rg h2 { font-size: var(--step-2); }
  .rg h3 { margin-top: 1.3em; }
  .rg__map { margin-bottom: 12px; }
  .ok { list-style: none; padding: 0; margin: 0; columns: 3; column-gap: 28px; }
  .ok li { padding: 6px 0; border-bottom: 1px solid var(--line); break-inside: avoid; }
  .ok a { text-decoration: none; font-weight: 600; }
  @media (max-width: 900px) { .rh__in, .rg { grid-template-columns: 1fr; } .ok { columns: 2; } }
</style>
