---
import Base from '../layouts/Base.astro';
import HeroUnit from '../components/HeroUnit.astro';
import QuickStart from '../components/QuickStart.astro';
import PeopleBento from '../components/PeopleBento.astro';
import BrandShowcase from '../components/BrandShowcase.astro';
import Img from '../components/Img.astro';
import ExplodedUnit from '../components/ExplodedUnit.astro';
import SeasonScene from '../components/SeasonScene.astro';
import QuietMeter from '../components/QuietMeter.astro';
import ColdSection from '../components/ColdSection.astro';
import UseTiles from '../components/UseTiles.astro';
import AppSection from '../components/AppSection.astro';
import ContourMap from '../components/ContourMap.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Degree from '../components/Degree.astro';
import MultiSplit from '../components/MultiSplit.astro';
import { brandMeta } from '../data/products';
import { getCollection } from 'astro:content';
import { site, regions } from '../data/site';
import { cities } from '../data/cities';
import { catNames, postImage } from '../data/blog';

const posts = (await getCollection('blog')).filter((p) => ['kolik-stoji-klimatizace-do-bytu', 'ticha-klimatizace-do-loznice', 'dotace-na-tepelne-cerpadlo'].includes(p.id));

const faq = [
  { q: 'Kolik stojí klimatizace s montáží?', a: 'Záleží hlavně na výkonu, řadě jednotky a délce potrubí. Orientační rozpětí najdete v článku <a href="/blog/kolik-stoji-klimatizace-do-bytu/">kolik stojí klimatizace do bytu</a>, přesnou cenu pro vás připraví partnerská firma po zaměření zdarma.' },
  { q: 'Kdo klimatizaci namontuje?', a: 'Ověřená partnerská montážní firma z vašeho kraje, která s jednotkami Mitsubishi Heavy Industries a Hisense dlouhodobě pracuje a má osvědčení pro práci s chladivy (F-plyny).' },
  { q: 'Je poptávka zpoplatněná nebo závazná?', a: 'Ne. Poptávka, zaměření i cenová nabídka jsou zdarma a k ničemu vás nezavazují.' },
  { q: 'Jak dlouho trvá montáž?', a: 'Jedna nástěnná klimatizace 4 až 6 hodin, multisplit pro více místností obvykle jeden až dva dny.' },
  { q: 'Můžu klimatizací i topit?', a: 'Ano. Invertorová klimatizace je tepelné čerpadlo vzduch-vzduch a topí úsporně i v mrazech. Více v článku <a href="/blog/topeni-klimatizaci/">topení klimatizací</a>.' },
  { q: 'Působíte i v mém kraji?', a: 'Ano, poptávky přijímáme z celé České republiky a předáváme je firmě, která to má k vám nejblíž.' },
];
const why = [
  { i: 'shield', t: `Záruka až ${site.warranty.mhi} let`, d: `Mitsubishi Heavy Industries ${site.warranty.mhi} let, Hisense ${site.warranty.hisense} roky.` },
  { i: 'check', t: 'Oficiální distribuce', d: 'Jednotky s podporou distributora pro ČR.' },
  { i: 'wrench', t: 'Certifikovaní technici', d: 'Osvědčení pro práci s chladivy.' },
  { i: 'pin', t: 'Firma z vašeho kraje', d: 'Krátký dojezd, rychlý servis.' },
  { i: 'chat', t: 'Jedna firma, žádný spam', d: 'Poptávku nerozesíláme hromadně.' },
  { i: 'clock', t: `Ozveme se ${site.responseTime}`, d: 'Zaměření a nabídka zdarma.' },
];
---
<Base
  darkHeader
  title="Klimatizace a tepelná čerpadla s montáží po celé ČR"
  description="Klimatizace a tepelná čerpadla Mitsubishi Heavy Industries a Hisense s montáží ve všech krajích ČR. Tichý chod, topení v zimě. Nabídka a zaměření zdarma."
>
  <HeroUnit />

  <PeopleBento />

  <section class="section qband" id="poptavka-rychla">
    <Degree class="qband__deg qband__deg--a" rings={5} />
    <Degree class="qband__deg qband__deg--b" rings={3} />
    <div class="wrap qband__in">
      <div data-reveal>
        <p class="kicker">Nezávazně a zdarma</p>
        <h2 class="display">Řekněte nám, co potřebujete. Zbytek zařídíme.</h2>
        <ol class="qband__steps">
          <li><Icon name="chat" /><span><strong>Pošlete poptávku</strong>Za dvě minuty, bez registrace.</span></li>
          <li><Icon name="ruler" /><span><strong>Zaměření zdarma</strong>Technik z vašeho kraje navrhne řešení.</span></li>
          <li><Icon name="ac" /><span><strong>Montáž obvykle za den</strong>Čistá práce, spuštění a zaškolení.</span></li>
        </ol>
        <div class="qband__brands">
          <span>Montujeme</span>
          <img src={brandMeta['mitsubishi-heavy-industries'].logo} alt="Mitsubishi Heavy Industries" height="22" width={Math.round(22 * brandMeta['mitsubishi-heavy-industries'].ratio)} />
          <img src={brandMeta.hisense.logo} alt="Hisense" height="22" width={Math.round(22 * brandMeta.hisense.ratio)} />
        </div>
      </div>
      <div class="qband__form" data-reveal data-reveal-delay="1">
        <div class="qband__unit" aria-hidden="true">
          <Img name="mhi-zsx-titan" alt="" sizes="(max-width: 900px) 70vw, 420px" />
          <span class="qband__chip"><Icon name="snow" size={16} /> 22 °C</span>
        </div>
        <QuickStart />
      </div>
    </div>
  </section>

  <BrandShowcase />

  <MultiSplit variant="teaser" />

  <ExplodedUnit />
  <SeasonScene />
  <QuietMeter />
  <ColdSection />

  <section class="section" aria-labelledby="use-h">
    <div class="wrap">
      <div class="center" data-reveal style="margin-bottom:40px">
        <p class="kicker">Pro každý prostor</p>
        <h2 id="use-h" class="display">Kam ji potřebujete?</h2>
      </div>
      <UseTiles />
    </div>
  </section>

  <AppSection />

  <section class="section section--night why" aria-labelledby="why-h">
    <div class="wrap">
      <div class="why__nums" data-reveal>
        <p><strong><span data-count="1">1</span> den</strong><span>ozveme se do jednoho pracovního dne od odeslání poptávky</span></p>
        <p><strong><span data-count="14">14</span></strong><span>krajů s montážními partnery</span></p>
        <p><strong><span data-count="5">5</span> let</strong><span>záruka na Mitsubishi Heavy Industries</span></p>
        <p><strong><span data-count="0">0</span> Kč</strong><span>za poptávku, zaměření a nabídku</span></p>
      </div>
      <h2 id="why-h" class="display why__h" data-reveal>Proč přes Klima Expert</h2>
      <div class="feats" data-reveal>
        {why.map((w) => <div class="feat"><Icon name={w.i} /><strong>{w.t}</strong><span>{w.d}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center" data-reveal style="margin-bottom:44px">
        <p class="kicker">Jak to probíhá</p>
        <h2 class="display">Od poptávky ke chladu za pár dní.</h2>
      </div>
      <Steps center />
    </div>
  </section>

  <section class="section section--stage" id="kraje">
    <div class="wrap regions">
      <div data-reveal>
        <p class="kicker">Celá Česká republika</p>
        <h2 class="display">Montujeme ve všech krajích.</h2>
        <ul class="regions__list">
          {regions.map((r) => <li><a href={`/montaz-klimatizace/${r.slug}/`}>{r.name}</a></li>)}
        </ul>
        <p class="regions__cities small">Města: {cities.map((c, i) => <>{i > 0 && ', '}<a href={`/montaz-klimatizace/${c.kraj}/${c.slug}/`}>{c.name}</a></>)}</p>
      </div>
      <div class="regions__map" data-reveal="scale"><ContourMap /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="pick__head" data-reveal>
        <div><p class="kicker">Poradna</p><h2 class="display">Než se rozhodnete.</h2></div>
        <a class="link-arrow" href="/blog/">Všechny články <Icon name="arrow" size={20} /></a>
      </div>
      <div class="posts">
        {posts.map((p, i) => (
          <a class="post" href={`/blog/${p.id}/`} data-reveal data-reveal-delay={String(i)}>
            <span class="post__img"><Img name={postImage(p.id, p.data.category)} alt="" sizes="(max-width: 900px) 92vw, 380px" /></span>
            <span class="post__cat">{catNames[p.data.category]}</span>
            <h3>{p.data.h1 ?? p.data.title}</h3>
            <p>{p.data.perex}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--stage">
    <div class="wrap">
      <Faq items={faq} />
      <details class="more more--faq">
        <summary><span class="more__t">Klimatizace s montáží: jak vybrat a na co se připravit</span><span class="more__b" aria-hidden="true"></span></summary>
        <div class="prose">
          <p>Klima Expert pomáhá vybrat klimatizaci nebo tepelné čerpadlo značek Mitsubishi Heavy Industries a Hisense a zajišťuje montáž prostřednictvím ověřených partnerských firem ve všech krajích České republiky. Poptávka, zaměření i cenová nabídka jsou zdarma.</p>
          <h2>Jaký typ klimatizace vybrat</h2>
          <p>Do bytů a rodinných domů se nejčastěji montují nástěnné split klimatizace. Pro více místností s jednou venkovní jednotkou slouží <a href="/klimatizace/multisplit/">multisplit</a>, do podkroví a pod okna parapetní jednotky a do kanceláří kazetové nebo kanálové jednotky skryté v podhledu. Přehled najdete v sekci <a href="/produkty/">produkty</a>.</p>
          <h2>Jaký výkon potřebuji</h2>
          <p>Pro běžnou místnost se počítá zhruba 100 W chladicího výkonu na m², pro slunné místnosti a podkroví více. Ložnice do 20 m² obvykle vystačí s jednotkou 2,0 až 2,5 kW. Podrobně v článku <a href="/blog/jaky-vykon-klimatizace-na-m2/">jaký výkon klimatizace na m²</a> nebo v <a href="/cena-klimatizace/">kalkulačce výkonu</a>.</p>
          <h2>Klimatizace v bytovém domě</h2>
          <p>Umístění venkovní jednotky na fasádu bytového domu vyžaduje souhlas SVJ nebo družstva. Moderní invertorové jednotky při správném umístění splní noční hlukový limit 40 dB před okny sousedů. Více v článku <a href="/blog/povoleni-klimatizace-svj/">povolení klimatizace a SVJ</a>.</p>
          <h2>Topení klimatizací a tepelná čerpadla</h2>
          <p>Klimatizace umí v zimě úsporně topit. Pro vytápění celého domu a ohřev vody slouží <a href="/tepelna-cerpadla/">tepelná čerpadla vzduch-voda</a> Hisense Hi-Therma, na která lze čerpat podporu z programu Nová zelená úsporám.</p>
        </div>
      </details>
    </div>
  </section>

  <section class="section final">
    <Degree rings={5} style="width:min(700px,85vw);left:-240px;top:-200px;opacity:.18" />
    <div class="wrap final__in">
      <div data-reveal>
        <div class="final__ph"><Img name="ph-family-sofa-joy" alt="Rodina doma na pohovce" sizes="(max-width: 900px) 92vw, 560px" /></div>
        <h2 class="display">Chcete mít doma klid a příjemný vzduch?</h2>
        <p class="sub">Pošlete nezávaznou poptávku. Ozveme se {site.responseTime} a partnerská firma připraví nabídku zdarma.</p>
        <p class="final__tel">Raději telefonicky? <a href={site.phoneHref}>{site.phone}</a></p>
      </div>
      <div data-reveal data-reveal-delay="1"><QuickStart heading="Začněte tady" /></div>
    </div>
  </section>

</Base>

<style>
  .more--faq { max-width: 78ch; margin: 28px 0 0; box-shadow: none; border: 1px solid var(--line); }
  .qband { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(60% 70% at 85% 30%, var(--ice), transparent 70%), radial-gradient(50% 60% at 0% 100%, #eef5ff, transparent 70%), var(--white); }
  .qband :global(.qband__deg) { z-index: -1; }
  .qband :global(.qband__deg--a) { width: clamp(460px, 50vw, 760px); right: -14%; top: -26%; opacity: 0.32; }
  .qband :global(.qband__deg--b) { width: clamp(220px, 24vw, 360px); left: -9%; bottom: -18%; opacity: 0.22; }
  .qband__in { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .qband__in > * { min-width: 0; }
  .qband .display { font-size: clamp(2rem, 1.3rem + 2.8vw, 3.6rem); }
  .qband__steps { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 18px; position: relative; }
  .qband__steps::before { content: ''; position: absolute; left: 26px; top: 26px; bottom: 26px; border-left: 2px dashed var(--ice-deep); }
  .qband__steps li { position: relative; display: grid; grid-template-columns: 52px 1fr; gap: 14px; align-items: center; color: var(--ink-soft); }
  .qband__steps :global(.ico) { width: 52px; height: 52px; padding: 12px; border-radius: 16px; background: var(--white); color: var(--sun); box-shadow: 0 10px 24px -14px rgba(14, 34, 51, 0.45), inset 0 0 0 1px var(--line); }
  .qband__brands { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 26px; margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--line); }
  .qband__brands span { font-size: var(--step--1); color: var(--ink-soft); font-weight: 600; }
  .qband__brands img { height: 22px; width: auto; }
  .qband__form { position: relative; padding-top: clamp(70px, 9vw, 120px); }
  .qband__unit { position: absolute; top: 0; left: 50%; width: min(78%, 420px); transform: translateX(-50%); z-index: 2; pointer-events: none; }
  .qband__unit :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 24px 22px rgba(14, 34, 51, 0.25)); }
  .qband__chip { position: absolute; right: -4%; top: 4%; display: inline-flex; align-items: center; gap: 5px; padding: 7px 12px; border-radius: 999px; background: var(--white); box-shadow: 0 10px 24px -12px rgba(14, 34, 51, 0.45); font: 700 0.9rem/1 var(--font-body); }
  .qband__chip :global(.ico) { color: var(--sun); }
  .qband__form :global(.qs) { position: relative; z-index: 1; padding-top: clamp(64px, 7vw, 84px); box-shadow: 0 40px 80px -50px rgba(14, 34, 51, 0.5); }
  .qband__steps strong { display: block; font: 700 var(--step-1)/1.2 var(--font-head); color: var(--ink); }
  .pick { padding-bottom: 48px; }
  .pick__head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; }
  .pick__head .display { margin: 0; }
  .why__nums { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 72px; }
  .why__nums p { margin: 0; display: grid; gap: 6px; align-content: start; }
  .why__nums strong { font: 700 clamp(2.4rem, 1.4rem + 3.5vw, 4.4rem)/1 var(--font-head); letter-spacing: -0.04em; color: #fff; }
  .why__nums p > span { color: #a9bfcc; font-size: var(--step--1); max-width: 26ch; }
  .why__h { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem); margin-bottom: 36px; }
  .regions { display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: center; }
  .regions .display { font-size: clamp(2rem, 1.3rem + 2.8vw, 3.6rem); }
  .regions__list { list-style: none; padding: 0; margin: 24px 0 0; columns: 2; column-gap: 24px; }
  .regions__list li { padding: 6px 0; break-inside: avoid; border-bottom: 1px solid var(--line); }
  .regions__list a { text-decoration: none; font-weight: 600; }
  .regions__list a:hover { text-decoration: underline; }
  .regions__cities { margin-top: 18px; color: var(--ink-soft); }
  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .post { display: grid; gap: 10px; align-content: start; padding: 0 0 26px; overflow: hidden; border-radius: 26px; background: var(--white); box-shadow: var(--shadow); text-decoration: none; transition: transform 0.4s var(--ease), background 0.3s; }
  .post:hover { transform: translateY(-4px); }
  .post__img { display: block; aspect-ratio: 16 / 10; overflow: hidden; margin-bottom: 8px; }
  .post__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .post:hover .post__img :global(img) { transform: scale(1.05); }
  .post > :not(.post__img) { margin-inline: 26px; }
  .post__cat { font-size: var(--step--1); font-weight: 600; color: var(--sun-deep); }
  .post h3 { font-size: var(--step-1); font-weight: 700; margin: 0; }
  .post p { color: var(--ink-soft); margin: 0; font-size: var(--step--1); }
  .final { position: relative; overflow: hidden; isolation: isolate; background: linear-gradient(180deg, var(--white), var(--ice)); }
  .final__in { position: relative; z-index: 1; }
  .final__in { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .final__in > * { min-width: 0; }
  .final .display { font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem); }
  .final__ph { border-radius: 24px; overflow: hidden; margin-bottom: 28px; aspect-ratio: 16 / 9; }
  .final__ph :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .final__tel { font-weight: 600; }
  .final__tel a { font-weight: 700; }
  .seo { padding-block: 24px 64px; }
  @media (max-width: 900px) {
    .qband__in, .regions, .final__in { grid-template-columns: 1fr; }
    .why__nums { grid-template-columns: 1fr 1fr; }
    .posts { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .regions__list { columns: 1; } }
</style>
