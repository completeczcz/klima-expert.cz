---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Img from '../../components/Img.astro';
import Degree from '../../components/Degree.astro';
import { products, brandMeta } from '../../data/products';
import { site } from '../../data/site';

const groups = [
  { id: 'nastenna', h: 'Nástěnné klimatizace', p: 'Nejčastější volba do bytů a domů.' },
  { id: 'parapetni', h: 'Parapetní a konzolové', p: 'U podlahy pod oknem, výborně topí. Ideální do podkroví.' },
  { id: 'kanalova', h: 'Kanálové (skryté v podhledu)', p: 'Vidět jsou jen mřížky.' },
  { id: 'kazetova', h: 'Kazetové', p: 'Do podhledu v kancelářích, obchodech a ordinacích.' },
  { id: 'podstropni', h: 'Podstropní', p: 'Pro velké místnosti bez podhledu.' },
  { id: 'tepelne-cerpadlo', h: 'Tepelná čerpadla vzduch-voda', p: 'Vytápění a teplá voda pro rodinné domy.' },
];
const tierOrder = { premium: 0, stredni: 1, zakladni: 2 };
const brands = [
  {
    slug: 'mitsubishi-heavy-industries', anchor: 'mitsubishi-heavy-industries', name: 'Mitsubishi Heavy Industries', img: 'mhi-zsx-titan',
    text: `Japonská klimatizace s tradicí od roku 1884. Velmi tiché a úsporné jednotky, v ČR přes výhradního distributora od roku 2007. Záruka ${site.warranty.mhi} let.`,
  },
  {
    slug: 'hisense', anchor: 'hisense', name: 'Hisense', img: 'his-airmaster-black',
    text: `Moderní klimatizace a tepelná čerpadla s výborným poměrem ceny a výbavy. Ovládání přes Wi-Fi, topení až do −22 °C. Záruka ${site.warranty.hisense} roky.`,
  },
];
---
<Base
  title="Klimatizace Mitsubishi Heavy Industries a Hisense – přehled řad"
  description="Přehled řad klimatizací a tepelných čerpadel Mitsubishi Heavy Industries a Hisense rozdělený podle značky: výkony, hlučnost, výbava a montáž po celé ČR."
  crumbs={[{ name: 'Produkty', href: '/produkty/' }]}
>
  <section class="section" style="padding-top:24px;padding-bottom:32px;position:relative;overflow:hidden;isolation:isolate">
    <Degree rings={5} style="width:min(640px,80vw);right:-180px;top:-220px;opacity:.2;z-index:-1" />
    <div class="wrap">
      <div class="section__head">
        <h1 class="display">Vyberte si značku.</h1>
        <p class="sub">Montujeme dvě značky, kterým věříme. Každá má své přednosti, nabídku vám připravíme zdarma.</p>
      </div>
      <div class="bpick">
        {brands.map((b) => {
          const m = brandMeta[b.slug];
          return (
            <a class="bpick__i" href={`#${b.anchor}`} style={`--brand:${m.color}`} data-reveal>
              <span class="bpick__ph"><Img name={b.img} alt={`Klimatizace ${b.name}`} sizes="(max-width: 800px) 80vw, 460px" /></span>
              <span class="bpick__body">
                <img class="bpick__logo" src={m.logo} alt={b.name} height="30" width={Math.round(30 * m.ratio)} />
                <span>{b.text}</span>
                <span class="bpick__go">Zobrazit řady ↓</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {brands.map((b) => {
    const m = brandMeta[b.slug];
    const mine = products.filter((p) => p.brandSlug === b.slug);
    return (
      <section class="brand" id={b.anchor} style={`--brand:${m.color};--brand-tint:${m.tint}`}>
        <div class="wrap">
          <header class="brand__head">
            <img src={m.logo} alt={b.name} height="40" width={Math.round(40 * m.ratio)} />
            <a class="link-arrow" href={`/znacky/${b.slug}/`}>O značce {b.name}</a>
          </header>
          {groups.map((g) => {
            const list = mine.filter((p) => p.cat === g.id).sort((x, y) => tierOrder[x.tier] - tierOrder[y.tier]);
            return list.length ? (
              <div class="grp">
                <h2>{g.h}</h2>
                <p class="muted">{g.p}</p>
                <div class="pgrid">{list.map((s) => <div data-reveal><ProductCard s={s} /></div>)}</div>
              </div>
            ) : null;
          })}
        </div>
      </section>
    );
  })}
  <CtaBand title="Nevíte, kterou vybrat?" text="Napište nám, kam klimatizaci chcete a kolik místností. Doporučíme vhodnou řadu a partnerská firma připraví nabídku zdarma." />
</Base>

<style>
  .bpick { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .bpick__i { display: grid; grid-template-rows: auto 1fr; border-radius: 28px; overflow: hidden; background: var(--white); text-decoration: none; color: var(--ink); box-shadow: var(--shadow); transition: transform 0.4s var(--ease); border-top: 4px solid var(--brand); }
  .bpick__i:hover { transform: translateY(-4px); }
  .bpick__ph { position: relative; display: block; aspect-ratio: 16 / 8; background: radial-gradient(70% 80% at 50% 55%, #ffffff, #eceef1); overflow: hidden; }
  .bpick__ph :global(img) { position: absolute; left: 12%; top: 18%; width: 76%; height: 64%; object-fit: contain; filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.16)); transition: transform 0.8s var(--ease); }
  .bpick__i:hover .bpick__ph :global(img) { transform: scale(1.04); }
  .bpick__body { padding: 24px 28px 28px; display: grid; gap: 12px; align-content: start; color: var(--ink-soft); }
  .bpick__logo { height: 30px; width: auto; }
  .bpick__go { font-weight: 600; color: var(--brand); }
  .brand { padding-block: clamp(48px, 6vw, 80px); background: linear-gradient(180deg, var(--brand-tint), var(--paper) 420px); border-top: 1px solid var(--line); scroll-margin-top: 72px; }
  .brand__head { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; padding-bottom: 8px; }
  .brand__head img { height: 40px; width: auto; }
  .brand__head .link-arrow { color: var(--brand); }
  .grp { padding-top: 36px; }
  .grp h2 { font-size: var(--step-2); margin-bottom: 0.2em; }
  .pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); gap: 20px; margin-top: 18px; }
  @media (max-width: 800px) { .bpick { grid-template-columns: 1fr; } }
</style>
