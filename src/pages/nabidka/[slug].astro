---
// Vstupní stránky pro Google Ads – bez hlavního menu, krátký formulář nad ohybem, noindex.
import Base from '../../layouts/Base.astro';
import ShortForm from '../../components/ShortForm.astro';
import Steps from '../../components/Steps.astro';
import Faq from '../../components/Faq.astro';
import { pages } from '../../data/ad-pages';



export function getStaticPaths() {
  return Object.keys(pages).map((slug) => ({ params: { slug } }));
}
const p = pages[Astro.params.slug as keyof typeof pages];
---
<Base title={p.title} description={p.lead.slice(0, 155)} noindex minimal hideStickyCta>
  <section class="ad">
    <div class="wrap ad__in">
      <div class="ad__txt">
        <h1>{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <ul class="checks ad__pts">{p.points.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="ad__form"><ShortForm typ={p.typ} note={`Reklamní stránka: ${p.title}`} /></div>
      <div class="ad__prices">
        <dl class="ad__pr">
          {p.prices.map((x) => <div><dt>{x.label}</dt><dd>{x.range}</dd></div>)}
        </dl>
        <p class="small muted">Orientační ceny vč. montáže a 12% DPH (byt, rodinný dům).</p>
      </div>
    </div>
  </section>
  <section class="trust-s">
    <div class="wrap trust-s__in">
      <p><strong>Od roku 2007</strong> výhradní distribuce Mitsubishi Heavy Industries v ČR přes partnera COMPLETE CZ</p>
      <p><strong>14 krajů</strong> montážní partneři po celé ČR</p>
      <p><strong>1 firma</strong> poptávku nerozesíláme hromadně</p>
    </div>
  </section>
  <section class="section section--ink"><div class="wrap"><div class="section__head"><h2>Jak to probíhá</h2></div><Steps /></div></section>
  <section class="section"><div class="wrap ad__faq"><Faq items={[...p.faq]} /><div><ShortForm typ={p.typ} id="sf2" heading="Pošlete poptávku" note={`Reklamní stránka: ${p.title}`} /></div></div></section>
</Base>
<style>
  .ad { padding: 16px 0 clamp(36px, 5vw, 64px); background: linear-gradient(180deg, var(--paper), var(--ice)); }
  .ad__in { display: grid; grid-template-columns: 1.25fr 1fr; grid-template-areas: 'txt form' 'pr form'; gap: 0 clamp(24px, 5vw, 64px); align-items: start; }
  .ad__txt { grid-area: txt; } .ad__form { grid-area: form; } .ad__prices { grid-area: pr; }
  .ad__in > * { min-width: 0; }
  .ad h1 { font-size: var(--step-3); max-width: 20ch; }
  .ad__pts { font-weight: 600; }
  .ad__pr { margin: 20px 0 6px; border-top: 2px solid var(--ink); }
  .ad__pr div { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .ad__pr dt { font-weight: 600; }
  .ad__pr dd { margin: 0; font: 800 var(--step-0)/1.3 var(--font-head); white-space: nowrap; }
  .trust-s { background: var(--white); border-block: 1px solid var(--line); }
  .trust-s__in { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding-block: 20px; font-size: var(--step--1); color: var(--ink-soft); }
  .trust-s p { margin: 0; }
  .trust-s strong { display: block; font: 800 var(--step-1)/1.2 var(--font-head); color: var(--ink); }
  .ad__faq { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 860px) { .ad__in { grid-template-columns: 1fr; grid-template-areas: 'txt' 'form' 'pr'; gap: 20px; } .ad__faq, .trust-s__in { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .ad__pr div { flex-direction: column; gap: 2px; } }
</style>
