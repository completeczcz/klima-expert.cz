---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import { imgFor } from '../data/product-images';
import { loadPerM2, extras } from '../data/pricing';

// Data pro kalkulačku výkonu: nástěnné řady a jejich výkony (bez cen)
const wall = products.filter((p) => p.cat === 'nastenna');
const series = wall.map((s) => ({
  id: s.id, t: s.title.replace(/^(Mitsubishi Heavy Industries|Hisense) /, ''), brand: s.brandSlug, brandName: s.brand, tier: s.tier,
  kws: s.models.map((m) => m.coolKw).filter(Boolean), noise: s.noiseMin, img: imgFor(s.id).img,
}));
const cfg = { series, loadPerM2 };

const factors = [
  { i: 'ac', t: 'Řada a výkon jednotky', d: 'Tišší a účinnější prémiové řady stojí víc, ale méně spotřebují.' },
  { i: 'ruler', t: 'Délka potrubí', d: 'Standardní montáž počítá s krátkou trasou mezi jednotkami.' },
  { i: 'building', t: 'Umístění venkovní jednotky', d: 'Fasáda, balkon, střecha, případně práce ve výšce.' },
  { i: 'drop', t: 'Odvod kondenzátu', d: 'Samospádem, nebo malým čerpadlem.' },
  { i: 'thermo', t: 'Elektroinstalace', d: 'Připojení do blízkého okruhu, nebo nový jistič.' },
  { i: 'home', t: 'Počet místností', d: 'Samostatné jednotky, nebo jeden multisplit.' },
];
const faq = [
  { q: 'Kolik stojí klimatizace do bytu s montáží?', a: 'Klimatizace do jedné místnosti se standardní montáží začíná zhruba na 30 tisících korun. Konečná cena záleží na řadě jednotky a montáži u vás doma. Podrobný rozbor najdete v článku <a href="/blog/kolik-stoji-klimatizace-do-bytu/">kolik stojí klimatizace do bytu</a>.' },
  { q: 'Proč se ceny u různých firem tolik liší?', a: 'Rozdíl dělá značka a řada jednotky, délka a vedení potrubí, způsob odvodu kondenzátu, montáž ve výšce a to, co firma do „standardní montáže“ zahrnuje. Vždy si nechte rozepsat, co je v ceně.' },
  { q: 'Jakou sazbu DPH zaplatím?', a: 'Při dodávce klimatizace s montáží do bytu nebo rodinného domu se obvykle uplatní snížená sazba 12 %. U kanceláří, provozoven, chat a garáží se platí 21 %.' },
  { q: 'Jak získám přesnou cenu?', a: 'Pošlete <a href="/poptavka/">nezávaznou poptávku</a>. Partnerská firma z vašeho kraje vše zaměří a připraví přesnou nabídku, zdarma.' },
];
---
<Base
  title="Kolik stojí klimatizace s montáží a jaký výkon zvolit"
  description="Na čem závisí cena klimatizace s montáží, co obsahuje standardní montáž a jaký výkon potřebujete. Kalkulačka výkonu a nabídka zdarma."
  crumbs={[{ name: 'Cena klimatizace', href: '/cena-klimatizace/' }]}
>
  <section class="kc">
    <div class="wrap kc__head" data-reveal>
      <h1 class="display">Kolik stojí klimatizace s montáží</h1>
      <p class="sub">Klimatizace do jedné místnosti se standardní montáží začíná zhruba na 30 tisících korun. Přesnou cenu vám po zaměření připraví partnerská firma, zdarma. Nejdřív si ale spočítejte, jaký výkon potřebujete.</p>
    </div>
    <div class="wrap calc">
      <form class="calc__in panel" id="calc" onsubmit="return false">
        <h2 class="calc__h">Kalkulačka výkonu</h2>
        <div id="rooms"></div>
        <button type="button" class="btn btn--ghost calc__add" id="add">Přidat místnost</button>
        <fieldset class="calc__pref">
          <legend>Značka</legend>
          <label><input type="radio" name="brand" value="" checked /> Je mi to jedno</label>
          <label><input type="radio" name="brand" value="mitsubishi-heavy-industries" /> Mitsubishi Heavy Industries</label>
          <label><input type="radio" name="brand" value="hisense" /> Hisense</label>
        </fieldset>
      </form>
      <div class="calc__out panel" aria-live="polite">
        <p class="calc__need" id="need"></p>
        <p class="calc__tip" id="tip"></p>
        <div id="results" class="calc__res"></div>
        <a class="btn btn--sun calc__cta" id="cta" href="/poptavka/">Chci přesnou cenu zdarma</a>
      </div>
    </div>
  </section>

  <section class="section section--stage">
    <div class="wrap">
      <div class="center" data-reveal style="margin-bottom:40px">
        <p class="kicker">Co ovlivní cenu</p>
        <h2 class="display" style="font-size:clamp(2rem,1.3rem + 2.8vw,3.6rem)">Šest věcí, na kterých záleží.</h2>
      </div>
      <div class="fx">
        {factors.map((f, i) => (
          <div class="fx__i" data-reveal data-reveal-delay={String(i % 3)}>
            <span class="fx__ico"><Icon name={f.i} size={26} /></span>
            <strong>{f.t}</strong><span>{f.d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div data-reveal>
        <h2 class="display" style="font-size:clamp(1.8rem,1.2rem + 2vw,2.8rem)">Co obsahuje standardní montáž</h2>
        <ul class="checks">
          <li>Chladivové potrubí s izolací do zhruba 3 m a propojovací kabel</li>
          <li>Konzole pro venkovní jednotku na stěnu nebo na zem</li>
          <li>Jeden průraz zdí a odvod kondenzátu samospádem</li>
          <li>Vakuování a tlaková zkouška těsnosti</li>
          <li>Uvedení do provozu, zaškolení a protokol o instalaci</li>
        </ul>
      </div>
      <div data-reveal data-reveal-delay="1">
        <h2 class="display" style="font-size:clamp(1.8rem,1.2rem + 2vw,2.8rem)">Co se často doplácí</h2>
        <ul class="checks">{extras.map((e) => <li>{e.label}</li>)}</ul>
        <p class="small muted">Konkrétní příplatky uvidíte v nabídce po zaměření.</p>
      </div>
    </div>
  </section>

  <section class="section section--stage"><div class="wrap"><Faq items={faq} /></div></section>
  <CtaBand title="Chcete přesnou cenu?" text="Pošlete poptávku a partnerská firma z vašeho kraje přijede zaměřit a připraví nabídku zdarma." />
</Base>

<script define:vars={{ cfg }}>
  const roomsEl = document.getElementById('rooms');
  const add = document.getElementById('add');
  const need = document.getElementById('need');
  const tip = document.getElementById('tip');
  const results = document.getElementById('results');
  const cta = document.getElementById('cta');
  const form = document.getElementById('calc');
  const SIZES = [2.0, 2.5, 3.5, 5.0, 6.3, 7.1];
  const fkw = (n) => String(n).replace('.', ',') + ' kW';
  const tierName = { premium: 'Prémiová', stredni: 'Střední třída', zakladni: 'Úsporná' };
  let n = 0;
  function addRoom(area = 20, type = 'bezne') {
    if (n >= 5) return;
    n++;
    const row = document.createElement('div');
    row.className = 'calc__room';
    row.innerHTML = `
      <span class="calc__rn">Místnost ${n}</span>
      <label><span class="visually-hidden">Plocha místnosti ${n} v m²</span><input type="number" min="5" max="120" value="${area}" inputmode="numeric" data-k="area" /> m²</label>
      <label><span class="visually-hidden">Typ místnosti ${n}</span><select data-k="type">
        <option value="bezne">běžná</option><option value="slunne">slunná, velká okna</option><option value="podkrovi">podkroví</option>
      </select></label>
      ${n > 1 ? '<button type="button" class="calc__del" aria-label="Odebrat místnost">×</button>' : ''}`;
    row.querySelector('select').value = type;
    roomsEl.appendChild(row);
    add.hidden = n >= 5;
    calc();
  }
  roomsEl.addEventListener('click', (e) => {
    if (!e.target.closest('.calc__del')) return;
    e.target.closest('.calc__room').remove();
    n = 0;
    roomsEl.querySelectorAll('.calc__room').forEach((r) => (r.querySelector('.calc__rn').textContent = 'Místnost ' + ++n));
    add.hidden = false;
    calc();
  });
  add.addEventListener('click', () => addRoom(15));
  form.addEventListener('input', calc);
  form.addEventListener('change', calc);
  function calc() {
    const brand = form.querySelector('input[name="brand"]:checked').value;
    const rooms = [...roomsEl.querySelectorAll('.calc__room')].map((r) => {
      const area = Math.max(5, Math.min(120, +r.querySelector('[data-k="area"]').value || 0));
      const type = r.querySelector('[data-k="type"]').value;
      const load = (area * cfg.loadPerM2[type]) / 1000;
      return { area, type, load, size: SIZES.find((s) => s >= load * 0.95) || 7.1 };
    });
    const total = rooms.reduce((a, r) => a + r.area, 0);
    need.innerHTML = rooms.length === 1
      ? `Doporučený výkon <strong>${fkw(rooms[0].size)}</strong>`
      : `Doporučené výkony <strong>${rooms.map((r) => fkw(r.size)).join(' + ')}</strong>`;
    tip.textContent = rooms.length >= 2
      ? 'Pro více místností zvažte multisplit: jedna venkovní jednotka pro všechny pokoje.'
      : 'Pro jednu místnost stačí samostatná nástěnná jednotka (single split).';
    const maxSize = Math.max(...rooms.map((r) => r.size));
    const fit = cfg.series.filter((s) => (!brand || s.brand === brand) && s.kws.some((k) => k >= maxSize - 0.35));
    const order = { premium: 0, stredni: 1, zakladni: 2 };
    const picks = ['premium', 'stredni', 'zakladni'].map((t) => fit.filter((s) => s.tier === t).sort((a, b) => (a.noise || 99) - (b.noise || 99))[0]).filter(Boolean);
    results.innerHTML = '<p class="calc__rh">Vhodné řady</p>' + picks.map((s) => `
      <a class="calc__s" href="/produkty/${s.id}/">
        ${s.img ? `<img src="/img/${s.img}-480.webp" alt="" loading="lazy">` : ''}
        <span><small>${tierName[s.tier]} · ${s.brandName}</small><strong>${s.t}</strong>${s.noise ? `<em>od ${s.noise} dB(A)</em>` : ''}</span>
      </a>`).join('');
    const typ = total > 90 || rooms.length >= 4 ? 'klimatizace-dum' : 'klimatizace-byt';
    const note = `Z kalkulačky: ${rooms.length} místnost(i), ${rooms.map((r) => r.area + ' m²').join(', ')}; výkon ${rooms.map((r) => fkw(r.size)).join(' + ')}.`;
    const q = new URLSearchParams({ typ, mistnosti: rooms.length >= 5 ? '5 a více' : String(rooms.length), plocha: String(total), poznamka: note });
    if (brand) q.set('znacka', brand === 'hisense' ? 'Hisense' : 'Mitsubishi Heavy Industries');
    cta.href = '/poptavka/?' + q.toString();
  }
  addRoom(22);
  window.gtag && window.gtag('event', 'calculator_view');
</script>

<style>
  .kc { padding: 24px 0 clamp(48px, 7vw, 88px); background: radial-gradient(90% 70% at 70% 30%, #ffffff, var(--stage) 55%, var(--ice)); }
  .kc__head { margin-bottom: 32px; }
  .kc .display { font-size: clamp(2.4rem, 1.3rem + 4vw, 4.8rem); max-width: 16ch; }
  .calc { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
  .calc > * { min-width: 0; }
  .calc__h { font-size: var(--step-1); }
  :global(.calc__room) { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  :global(.calc__rn) { font-weight: 700; min-width: 90px; }
  :global(.calc__room input), :global(.calc__room select) { font: inherit; padding: 9px 10px; border: 1.5px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--ink); }
  :global(.calc__room input) { width: 80px; }
  :global(.calc__del) { margin-left: auto; width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid var(--line); background: var(--white); font-size: 1.2rem; cursor: pointer; color: var(--ink); }
  .calc__add { margin-top: 14px; min-height: 42px; }
  .calc__pref { border: 0; padding: 0; margin: 20px 0 0; display: grid; gap: 8px; }
  .calc__pref legend { font-weight: 700; margin-bottom: 6px; }
  .calc__pref input { accent-color: var(--ink); }
  .calc__out { position: sticky; top: 96px; display: grid; gap: 10px; }
  .calc__need { font: 400 var(--step-1)/1.3 var(--font-body); margin: 0; }
  .calc__need :global(strong) { font: 700 var(--step-3)/1.1 var(--font-head); display: block; letter-spacing: -0.02em; }
  .calc__tip { margin: 0; color: var(--ink-soft); }
  :global(.calc__rh) { font-weight: 700; margin: 10px 0 0; }
  .calc__res { display: grid; gap: 10px; }
  :global(.calc__s) { display: grid; grid-template-columns: 120px 1fr; gap: 14px; align-items: center; padding: 10px; border-radius: 16px; background: var(--stage); text-decoration: none; color: var(--ink); transition: background 0.2s; }
  :global(.calc__s:hover) { background: var(--ice); }
  :global(.calc__s img) { width: 120px; height: 56px; object-fit: contain; }
  :global(.calc__s span) { display: grid; gap: 2px; }
  :global(.calc__s small) { color: var(--ink-soft); }
  :global(.calc__s em) { font-style: normal; font-size: var(--step--1); color: var(--sun-deep); font-weight: 700; }
  .calc__cta { width: 100%; margin-top: 8px; }
  .fx { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .fx__i { padding: 28px; border-radius: 26px; background: var(--white); display: grid; gap: 8px; align-content: start; }
  .fx__i strong { font: 700 var(--step-1)/1.25 var(--font-head); }
  .fx__i > span:last-child { color: var(--ink-soft); font-size: var(--step--1); }
  .fx__ico { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: var(--ice); color: var(--ink); }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  @media (max-width: 900px) { .calc, .two, .fx { grid-template-columns: 1fr; } .calc__out { position: static; } }
  @media (min-width: 560px) and (max-width: 900px) { .fx { grid-template-columns: 1fr 1fr; } }
</style>
