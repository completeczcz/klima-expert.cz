---
// Šablona vstupních stránek služeb (klimatizace do bytu, domu, kanceláře, TČ…)
import Base from './Base.astro';
import QuickStart from '../components/QuickStart.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Steps from '../components/Steps.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Degree from '../components/Degree.astro';
import { brandMeta, type Series } from '../data/products';

interface Feat { i: string; t: string; d: string }
interface Props {
  title: string;
  description: string;
  h1: string;
  lead: string;
  points: string[];
  preset: string;
  crumbs: { name: string; href: string }[];
  image?: string;
  feats?: Feat[];
  series?: Series[];
  seriesTitle?: string;
  seriesLead?: string;
  faq?: { q: string; a: string }[];
  ctaTitle?: string;
  moreTitle?: string;
  schema?: Record<string, unknown>[];
  /** slug značky – stránka dostane barvy a logo výrobce */
  brand?: string;
}
const { title, description, h1, lead, points, preset, crumbs, image = 'room-living', feats = [], series = [], seriesTitle = 'Doporučené řady', seriesLead, faq = [], ctaTitle, moreTitle, schema = [], brand } = Astro.props;
const bm = brand ? brandMeta[brand] : undefined;
const bstyle = bm ? `--brand:${bm.color};--brand-tint:${bm.tint}` : undefined;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: h1,
  description,
  provider: { '@id': 'https://klima-expert.cz/#firma' },
  areaServed: { '@type': 'Country', name: 'Česká republika' },
};
---
<Base title={title} description={description} crumbs={crumbs} schema={[serviceSchema, ...schema]}>
  <section data-dark class:list={["lh", { "lh--brand": bm }]} data-scrub="pass" data-reduce-p="0.5" style={bstyle}>
    <div class="lh__bg"><Img name={image} alt="" sizes="100vw" eager /></div>
    <Degree tone="light" rings={5} style="width:min(720px,90vw);right:-200px;bottom:-300px;opacity:.14" />
    <div class="wrap lh__in">
      <div class="lh__txt" data-reveal>
        {bm && <img class="lh__brand" src={bm.logoWhite} alt="" height="34" width={Math.round(34 * bm.ratio)} />}
        <h1 class="display">{h1}</h1>
        <p class="sub">{lead}</p>
        <ul class="lh__pts">{points.map((p) => <li><Icon name="check" size={20} />{p}</li>)}</ul>
      </div>
      <div data-reveal data-reveal-delay="1"><QuickStart preset={preset} /></div>
    </div>
  </section>

  <slot name="top" />

  {feats.length > 0 && (
    <section class:list={["section", { "lfeat--brand": bm }]} style={bstyle}>
      <div class="wrap feats" data-reveal>
        {feats.map((f) => <div class="feat"><Icon name={f.i} size={30} /><strong>{f.t}</strong><span>{f.d}</span></div>)}
      </div>
    </section>
  )}

  {series.length > 0 && (
    <section class="section section--stage" style={bstyle}>
      <div class="wrap">
        <div class="lser__head" data-reveal>
          <div>
            {bm && <img class="lser__logo" src={bm.logo} alt="" height="30" width={Math.round(30 * bm.ratio)} />}
            <h2 class="display" style="font-size:clamp(2rem,1.3rem + 2.8vw,3.6rem)">{seriesTitle}</h2>
            {seriesLead && <p class="sub">{seriesLead}</p>}
          </div>
          <a class="link-arrow" href="/produkty/">Všechny řady <Icon name="arrow" size={20} /></a>
        </div>
        <div class="lser">{series.map((s) => <div data-reveal><ProductCard s={s} /></div>)}</div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="center" data-reveal style="margin-bottom:44px">
        <p class="kicker">Jak to probíhá</p>
        <h2 class="display" style="font-size:clamp(2rem,1.3rem + 2.8vw,3.6rem)">Od poptávky k montáži bez starostí.</h2>
      </div>
      <Steps />
    </div>
  </section>

  {faq.length > 0 && <section class="section section--stage"><div class="wrap"><Faq items={faq} /></div></section>}

  <section class="section lmore">
    <div class="wrap">
      <details class="more">
        <summary><span class="more__t">{moreTitle ?? `Více o tématu: ${h1.toLowerCase()}`}</span><span class="more__b" aria-hidden="true"></span></summary>
        <div class="lc"><slot /></div>
      </details>
    </div>
  </section>

  <CtaBand title={ctaTitle} />
</Base>

<style>
  .lh { --p: 0.5; position: relative; overflow: hidden; color: #fff; background: var(--night); }
  .lh__bg { position: absolute; inset: 0; }
  .lh__bg :global(img) { width: 100%; height: 112%; object-fit: cover; transform: translateY(calc((var(--p) - 0.5) * -8%)); }
  .lh::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14, 34, 51, 0.88), rgba(14, 34, 51, 0.55) 55%, rgba(14, 34, 51, 0.25)); }
  .lh__in { position: relative; z-index: 1; display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; padding-block: clamp(56px, 9vw, 120px); }
  .lh__in > * { min-width: 0; }
  .lh .display { font-size: clamp(2.4rem, 1.3rem + 4vw, 4.8rem); max-width: 14ch; }
  .lh .sub { color: #dbe7ed; }
  .lh__pts { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 10px; font-weight: 600; }
  .lh__pts li { display: flex; gap: 10px; align-items: center; }
  .lh__pts :global(.ico) { color: var(--accent-dark); flex: none; }
  .lh__brand { height: 34px; width: auto; margin-bottom: 22px; display: block; }
  .lh--brand { box-shadow: inset 0 4px 0 var(--brand); }
  .lfeat--brand .feat :global(.ico) { color: var(--brand); }
  .lser__logo { height: 30px; width: auto; margin-bottom: 14px; display: block; }
  .lser__head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; }
  .lser { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 20px; }
  .lmore { padding-block: 32px 64px; }
  .lc :global(.copy) { padding-block: 8px 16px; }
  .lc :global(.copy > .wrap) { width: 100%; }
  .lc :global(.copy__grid) { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .lc :global(.copy h2) { font-size: var(--step-2); }
  .lc :global(.copy h3) { margin-top: 1.4em; }
  .lc :global(.copy p), .lc :global(.copy li) { max-width: 70ch; }
  @media (max-width: 900px) {
    .lh__in { grid-template-columns: 1fr; }
    .lh::after { background: linear-gradient(180deg, rgba(14, 34, 51, 0.85), rgba(14, 34, 51, 0.7)); }
  }
</style>
