---
// Lidská stránka: k čemu klimatizace doma je. Fotky lidí v bento mřížce.
import Img from './Img.astro';
const tiles = [
  { img: 'mhi-family-dining', t: 'Celá rodina v pohodě, i když je venku 34 °C.', big: true, pos: '50% 40%' },
  { img: 'ph-wake-up-stretch-1', t: 'Ráno odpočatí i po tropické noci.', pos: '50% 35%' },
  { img: 'ph-home-office-window', t: 'Práce z domova v klidu a chládku.', pos: '50% 50%' },
];
---
<section class="section pb" aria-labelledby="pb-h">
  <div class="wrap">
    <div class="pb__head" data-reveal>
      <p class="kicker">Pro celou rodinu</p>
      <h2 id="pb-h" class="display">Domov, kde je vždycky příjemně.</h2>
      <p class="sub">Klimatizace není jen přístroj na zdi. Je to klidný spánek v tropické noci, pohoda pro celou rodinu i v horku a teplo v přechodném období bez zapínání kotle.</p>
    </div>
    <div class="pb__grid">
      {tiles.map((x, i) => (
        <figure class:list={['pb__t', { 'pb__t--big': x.big }]} data-reveal="scale" data-reveal-delay={String(i)}>
          <Img name={x.img} alt={x.t} sizes={x.big ? '(max-width: 1240px) 92vw, 1200px' : '(max-width: 800px) 92vw, 600px'} style={`object-position:${x.pos}`} />
          <figcaption>{x.t}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .pb { background: var(--white); }
  .pb__head { max-width: 760px; margin-bottom: clamp(28px, 4vw, 48px); }
  .pb__head .display { font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4.4rem); }
  .pb__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .pb__t { position: relative; margin: 0; border-radius: 28px; overflow: hidden; isolation: isolate; aspect-ratio: 4 / 3; }
  .pb__t--big { grid-column: 1 / -1; aspect-ratio: 7 / 3; }
  .pb__t :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.4s var(--ease); }
  .pb__t:hover :global(img) { transform: scale(1.04); }
  .pb__t::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(0, 0, 0, 0.55), transparent 50%); }
  .pb__t figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 26px; color: #fff; font: 700 var(--step-1)/1.2 var(--font-head); letter-spacing: -0.01em; }
  .pb__t--big figcaption { font-size: var(--step-3); padding: clamp(22px, 3vw, 40px); max-width: 20ch; }
  @media (max-width: 800px) {
    .pb__grid { grid-template-columns: 1fr; gap: 12px; }
    .pb__t, .pb__t--big { aspect-ratio: 4 / 3; border-radius: 22px; }
    .pb__t--big :global(img) { object-position: 66% 40% !important; }
    .pb__t figcaption, .pb__t--big figcaption { font-size: var(--step-1); padding: 16px 18px; }
  }
</style>
