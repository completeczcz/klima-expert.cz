---
// Lidská stránka: k čemu klimatizace doma je. Fotky lidí v bento mřížce.
import Img from './Img.astro';
const tiles = [
  { img: 'ph-family-sofa-toys', t: 'Děti si hrají, i když je venku 34 °C.', big: true },
  { img: 'ph-wake-up-stretch-1', t: 'Ráno odpočatí i po tropické noci.' },
  { img: 'ph-senior-couple-hug-sofa', t: 'Příjemné teplo bez přetápění.' },
  { img: 'ph-home-office-window', t: 'Práce z domova v klidu a chládku.' },
  { img: 'ph-couple-sofa-hug', t: 'Večer jen pro vás dva.' },
];
---
<section class="section pb" aria-labelledby="pb-h">
  <div class="wrap">
    <div class="pb__head" data-reveal>
      <p class="kicker">Pro celou rodinu</p>
      <h2 id="pb-h" class="display">Domov, kde je vždycky příjemně.</h2>
      <p class="sub">Klimatizace není jen přístroj na zdi. Je to klidný spánek v tropické noci, děti, které si hrají i v horku, a teplo v přechodném období bez zapínání kotle.</p>
    </div>
    <div class="pb__grid">
      {tiles.map((x, i) => (
        <figure class:list={['pb__t', { 'pb__t--big': x.big }]} data-reveal="scale" data-reveal-delay={String(i % 3)}>
          <Img name={x.img} alt={x.t} sizes={x.big ? '(max-width: 800px) 92vw, 580px' : '(max-width: 800px) 46vw, 290px'} />
          <figcaption>{x.t}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .pb { background: var(--white); }
  .pb__head { max-width: 760px; margin-bottom: clamp(28px, 4vw, 48px); }
  .pb__head .display { font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4.4rem); }
  .pb__grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(180px, 20vw, 280px); gap: 14px; }
  .pb__t { position: relative; margin: 0; border-radius: 24px; overflow: hidden; isolation: isolate; }
  .pb__t--big { grid-column: span 2; grid-row: span 2; }
  .pb__t :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.4s var(--ease); }
  .pb__t:hover :global(img) { transform: scale(1.04); }
  .pb__t::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(0, 0, 0, 0.55), transparent 50%); }
  .pb__t figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 16px 18px; color: #fff; font: 600 var(--step-0)/1.25 var(--font-head); }
  .pb__t--big figcaption { font-size: var(--step-2); padding: 24px 28px; max-width: 18ch; }
  @media (max-width: 800px) {
    .pb__grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 170px; }
    .pb__t--big { grid-row: span 2; }
    .pb__t figcaption { font-size: 0.9rem; padding: 12px 14px; }
  }
</style>
