---
import { site } from '../data/site';
import Degree from './Degree.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Pošlete nezávaznou poptávku',
  text = 'Popište, co potřebujete. Partnerská montážní firma z vašeho kraje se ozve, domluví zaměření a připraví cenovou nabídku zdarma.',
} = Astro.props;
---
<section class="ctab section--ink" data-dark>
  <Degree tone="light" rings={5} style="width:min(620px,70vw);right:-140px;top:-200px;opacity:.16" />
  <div class="wrap ctab__in">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="ctab__act">
      <a class="btn btn--sun" href="/poptavka/" data-track="cta-band">Vyplnit poptávku</a>
      <a class="btn btn--ghost" href={site.phoneHref}>Zavolat {site.phone}</a>
    </div>
  </div>
</section>
<style>
  .ctab { padding-block: clamp(48px, 7vw, 88px); position: relative; overflow: hidden; }
  .ctab__in { position: relative; z-index: 1; display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; }
  .ctab h2 { color: var(--paper); }
  .ctab .lead { margin: 0; }
  .ctab__act { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
  @media (max-width: 860px) { .ctab__in { grid-template-columns: 1fr; } .ctab__act { justify-content: flex-start; } }
</style>
