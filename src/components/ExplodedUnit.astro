---
// Uvnitř klimatizace: skutečné snímky jednotky (Hisense), které se při posouvání prolínají krok po kroku.
// Sticky sekce, motion.ts nastaví data-step 0–4 podle posunu.
import Img from './Img.astro';
const parts = [
  { t: 'Čelní panel', d: 'Odklopí se jedním pohybem. Pod ním je vše, co potřebuje údržbu, po ruce.', img: 'hk-open-unit', fit: 'contain' },
  { t: 'Filtry', d: 'Zachytí prach, pyl i alergeny. Vyndáte je bez nářadí a opláchnete pod sprchou.', img: 'hk-uni-clean', fit: 'cover' },
  { t: 'Výměník', d: 'Tady se vzduch ochladí, nebo ohřeje. Po vypnutí se sám vysuší a vyčistí, aby uvnitř nevznikaly plísně.', img: 'hk-px-clean', fit: 'cover' },
  { t: 'Tichý ventilátor', d: 'Válcový ventilátor s plynulou regulací. V nočním režimu kolem 19 dB(A), tišší než šepot.', img: 'hk-uni-service', fit: 'cover' },
  { t: 'Lamely', d: 'Rozvádějí vzduch nahoru, dolů i do stran, aby nefoukalo přímo na vás.', img: 'hk-am-90', fit: 'cover' },
];
---
<section class="xu" data-dark data-scrub data-steps={String(parts.length)} data-step="0" data-reduce-p="0" aria-labelledby="xu-h">
  <div class="xu__sticky">
    <div class="wrap xu__grid">
      <div class="xu__text">
        <p class="kicker">Uvnitř klimatizace</p>
        <h2 id="xu-h" class="display">Co se skrývá pod&nbsp;krytem.</h2>
        <ol class="xu__list">
          {parts.map((p, i) => (
            <li class="xu__lab" data-i={i}>
              <span class="xu__n">{i + 1}</span>
              <div><strong>{p.t}</strong><span>{p.d}</span></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="xu__stage">
        <div class="xu__frame">
          {parts.map((p, i) => (
            <figure class:list={['xu__shot', `xu__shot--${p.fit}`]} data-i={i}>
              <Img name={p.img} alt={`${p.t} klimatizace`} sizes="(max-width: 900px) 92vw, 700px" />
            </figure>
          ))}
        </div>
        <div class="xu__bar" aria-hidden="true">{parts.map((_, i) => <i data-i={i}></i>)}</div>
        <p class="xu__src">Ilustrační snímky: Hisense</p>
      </div>
    </div>
  </div>
</section>

<style>
  .xu { --p: 0; position: relative; height: 250vh; background: radial-gradient(120% 80% at 70% 40%, var(--night-2), var(--night) 60%); color: #eef4f7; }
  .xu__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; align-items: center; overflow: hidden; padding-top: 72px; }
  .xu__grid { display: grid; grid-template-columns: 0.85fr 1.35fr; gap: clamp(24px, 4vw, 64px); align-items: center; }
  .xu__grid > * { min-width: 0; }
  .xu__text { position: relative; z-index: 2; }
  .xu .display { font-size: clamp(2.2rem, 1.4rem + 3vw, 4.2rem); }
  .xu__list { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 6px; }
  .xu__lab { display: grid; grid-template-columns: 34px 1fr; gap: 14px; padding: 10px 14px 10px 10px; border-radius: 16px; opacity: 0.4; transition: opacity 0.4s var(--ease), background 0.4s var(--ease); }
  .xu__lab strong { display: block; font: 700 var(--step-1)/1.2 var(--font-head); }
  .xu__lab div > span { display: block; color: #a9bfcc; font-size: var(--step--1); max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.5s var(--ease), opacity 0.4s var(--ease), margin 0.4s; }
  .xu__n { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 0.9rem; border: 1.5px solid rgba(255, 255, 255, 0.35); transition: background 0.3s, border-color 0.3s; }
  .xu[data-step='0'] .xu__lab[data-i='0'], .xu[data-step='1'] .xu__lab[data-i='1'], .xu[data-step='2'] .xu__lab[data-i='2'],
  .xu[data-step='3'] .xu__lab[data-i='3'], .xu[data-step='4'] .xu__lab[data-i='4'] { opacity: 1; background: rgba(255, 255, 255, 0.06); }
  .xu[data-step='0'] .xu__lab[data-i='0'] div > span, .xu[data-step='1'] .xu__lab[data-i='1'] div > span, .xu[data-step='2'] .xu__lab[data-i='2'] div > span,
  .xu[data-step='3'] .xu__lab[data-i='3'] div > span, .xu[data-step='4'] .xu__lab[data-i='4'] div > span { max-height: 6em; opacity: 1; margin-top: 4px; }
  .xu[data-step='0'] .xu__lab[data-i='0'] .xu__n, .xu[data-step='1'] .xu__lab[data-i='1'] .xu__n, .xu[data-step='2'] .xu__lab[data-i='2'] .xu__n,
  .xu[data-step='3'] .xu__lab[data-i='3'] .xu__n, .xu[data-step='4'] .xu__lab[data-i='4'] .xu__n { background: var(--sun); border-color: var(--sun); }

  .xu__frame { position: relative; aspect-ratio: 16 / 10; border-radius: 28px; overflow: hidden; background: radial-gradient(80% 80% at 50% 40%, #2a4157, #13263a); box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
  .xu__shot { position: absolute; inset: 0; margin: 0; opacity: 0; transform: scale(1.04); transition: opacity 0.6s var(--ease), transform 0.9s var(--ease); }
  .xu__shot :global(img) { width: 100%; height: 100%; display: block; }
  .xu__shot--cover :global(img) { object-fit: cover; }
  .xu__shot--contain { padding: 12% 8%; }
  .xu__shot--contain :global(img) { object-fit: contain; filter: drop-shadow(0 30px 30px rgba(0, 0, 0, 0.5)); }
  .xu[data-step='0'] .xu__shot[data-i='0'], .xu[data-step='1'] .xu__shot[data-i='1'], .xu[data-step='2'] .xu__shot[data-i='2'],
  .xu[data-step='3'] .xu__shot[data-i='3'], .xu[data-step='4'] .xu__shot[data-i='4'] { opacity: 1; transform: none; }
  .xu__bar { display: flex; gap: 6px; margin-top: 16px; }
  .xu__bar i { flex: 1; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.15); transition: background 0.4s; }
  .xu[data-step='0'] .xu__bar i[data-i='0'], .xu[data-step='1'] .xu__bar i:is([data-i='0'], [data-i='1']),
  .xu[data-step='2'] .xu__bar i:is([data-i='0'], [data-i='1'], [data-i='2']), .xu[data-step='3'] .xu__bar i:not([data-i='4']), .xu[data-step='4'] .xu__bar i { background: var(--sun); }
  .xu__src { margin: 10px 0 0; font-size: 0.78rem; color: #7f97a8; text-align: right; }
  @media (max-width: 900px) {
    .xu { height: 230vh; }
    .xu__grid { grid-template-columns: 1fr; gap: 6px; }
    .xu__stage { order: -1; }
    .xu__frame { aspect-ratio: 16 / 9; border-radius: 20px; }
    .xu .display { font-size: clamp(1.6rem, 1.2rem + 3vw, 2.4rem); margin-bottom: 0; }
    .xu__list { margin-top: 8px; gap: 2px; }
    .xu__lab { padding: 6px 10px 6px 6px; grid-template-columns: 28px 1fr; }
    .xu__n { width: 26px; height: 26px; }
    .xu__src { display: none; }
  }
  :global(html.reduce) .xu { height: auto; }
  :global(html.reduce) .xu__sticky { position: static; height: auto; padding-block: 80px; }
</style>
