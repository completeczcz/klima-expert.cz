---
// Úvod: claim + skutečný interiér s klimatizací, ze které jemně proudí chladný vzduch.
// Fotka je ořez RAC_2025_FRONT (Mitsubishi Heavy Industries), rámeček drží její poměr stran,
// takže proudění je umístěné v procentech přesně pod lamelami jednotky.
import Img from './Img.astro';
import Icon from './Icon.astro';
---
<section class="hu" data-dark data-scrub data-reduce-p="0" aria-labelledby="hu-h">
  <div class="hu__sticky">
    <div class="wrap hu__text">
      <h1 id="hu-h" class="hu__h1">Klimatizace a tepelná čerpadla s montáží po celé ČR</h1>
      <p class="display hu__claim">Chladno v létě. Teplo v zimě. <span>Pohodlí celý rok.</span></p>
      <div class="btn-row hu__cta">
        <a class="btn btn--sun" href="/poptavka/" data-track="cta-hero">Chci nabídku zdarma</a>
        <a class="btn btn--ghost" href="#vyber">Vybrat klimatizaci</a>
      </div>
    </div>
    <div class="hu__stage">
      <div class="hu__frame">
        <Img name="hero-room" alt="Obývací pokoj s nástěnnou klimatizací Mitsubishi Heavy Industries" sizes="(max-width: 1240px) 100vw, 1240px" eager />
        <div class="hu__air" aria-hidden="true">
          <div class="hu__cone">
            <span class="hu__haze"></span>
            <span class="hu__wave hu__wave--a"></span>
            <span class="hu__wave hu__wave--b"></span>
          </div>
        </div>
        <span class="hu__chip"><Icon name="snow" size={18} /> 22 °C</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hu { --p: 0; height: 128vh; position: relative; color: #f2f6f8; background: radial-gradient(70% 50% at 50% 30%, #17293b, #0b1724 70%); }
  .hu__sticky { position: sticky; top: 72px; height: calc(100svh - 72px); min-height: 600px; display: grid; grid-template-rows: auto minmax(0, 1fr); overflow: hidden; padding-top: clamp(18px, 4vh, 44px); }
  .hu__text { position: relative; z-index: 2; text-align: center; opacity: calc(1 - var(--p) * 2.4); transform: translateY(calc(var(--p) * -70px)); }
  .hu__h1 { font: 600 var(--step-0)/1.4 var(--font-body); color: #a9bfcc; margin: 0 auto 12px; max-width: 40ch; }
  .hu__claim { margin: 0 auto; max-width: 18ch; font-size: clamp(2.2rem, 0.4rem + 4.2vh + 2vw, 5rem); line-height: 1.02; }
  .hu__claim span { display: block; background: linear-gradient(90deg, #7cc8ff, #d9f0ff 45%, #ffd2a1 75%, var(--warm)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hu__cta { justify-content: center; margin-top: 22px; }
  .hu__cta .btn--ghost { color: #fff; }

  /* Fotka interiéru: při posunu se zvětší (Apple styl) */
  .hu__stage { position: relative; display: grid; place-items: start center; padding-top: clamp(20px, 3.5vh, 40px); min-height: 0; }
  .hu__frame { position: relative; width: min(100% - 2 * var(--gutter), 1100px);
    aspect-ratio: 2307 / 1298; border-radius: calc(28px * (1 - min(var(--p) * 1.35, 1))); overflow: hidden;
    transform: translateY(calc(min(var(--p) * 1.35, 1) * -46vh)) scale(calc(1 + min(var(--p) * 1.35, 1) * 0.5)); transform-origin: 50% 0;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7); }
  .hu__frame > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Proudění: kužel pod lamelami (x 39–61 %, y 29 %), rozmazaný, s pomalými vlnami vzduchu */
  .hu__air { position: absolute; left: 14%; width: 72%; top: 29.4%; height: 66%; filter: blur(8px); mix-blend-mode: screen; pointer-events: none; opacity: 1; }
  .hu__cone { position: absolute; inset: 0; overflow: hidden; clip-path: polygon(34.5% 0, 65.5% 0, 100% 100%, 0 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.8) 45%, transparent 96%); mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.8) 45%, transparent 96%); }
  .hu__haze { position: absolute; inset: 0; background: radial-gradient(60% 55% at 50% 0%, rgba(214, 238, 255, 0.95), rgba(165, 214, 255, 0.55) 50%, rgba(140, 200, 255, 0.15) 80%, transparent 95%); }
  /* Vlny: perioda gradientu dělí posun beze zbytku (50 % = 5 period / 4 periody), takže smyčka nemá viditelný šev */
  .hu__wave { position: absolute; left: -10%; right: -10%; top: -100%; height: 200%; will-change: transform;
    background: repeating-linear-gradient(180deg, transparent 0%, rgba(225, 243, 255, 0.75) 5%, transparent 10%);
    animation: hu-down 6s linear infinite, hu-breathe 9s ease-in-out infinite alternate; }
  .hu__wave--b { background: repeating-linear-gradient(180deg, transparent 0%, rgba(225, 243, 255, 0.55) 6.25%, transparent 12.5%);
    animation-duration: 9.5s, 13s; opacity: 0.7; }
  @keyframes hu-down { from { transform: translateY(0); } to { transform: translateY(50%); } }
  @keyframes hu-breathe { from { opacity: 0.55; } to { opacity: 1; } }

  .hu__chip { position: absolute; left: 63%; top: 18%; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.82); color: #1d1d1f; font: 600 0.92rem/1 var(--font-body); backdrop-filter: blur(8px); box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.4);
    opacity: calc(1 - var(--p) * 2.5); }
  .hu__chip :global(.ico) { color: #2b7fff; }

  .hu__facts { position: relative; z-index: 2; list-style: none; margin: 0 auto; padding: 16px 0 22px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; color: #cfe0e8; font-weight: 600; font-size: var(--step--1); opacity: calc(1 - var(--p) * 2); }
  .hu__facts li { display: inline-flex; align-items: center; gap: 8px; }
  .hu__facts :global(.ico) { color: var(--accent-dark); }

  @media (max-width: 700px) {
    .hu { height: 118vh; }
    .hu__claim { font-size: clamp(2.1rem, 1.1rem + 6vw, 3rem); }
    .hu__frame { width: calc(100% - 2 * var(--gutter)); }
    .hu__chip { font-size: 0.78rem; padding: 6px 10px; }
    .hu__facts { gap: 8px 16px; }
  }
  :global(html.reduce) .hu { height: auto; }
  :global(html.reduce) .hu__sticky { position: relative; height: auto; padding-bottom: 24px; }
  :global(html.reduce) .hu__wave { animation: none; }
</style>
