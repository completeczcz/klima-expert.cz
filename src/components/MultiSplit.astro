---
// Multisplit vysvětlený lidsky: jedna venkovní jednotka pro 2–5 pokojů.
// variant="full" = podrobně (stránka /klimatizace/multisplit/), "teaser" = pozvánka na úvodní stránce.
import Img from './Img.astro';
import Icon from './Icon.astro';
interface Props { variant?: 'full' | 'teaser' }
const { variant = 'full' } = Astro.props;
const cards = [
  { img: 'hk-ms-rooms', t: '2 až 5 pokojů, jedna venkovní jednotka', d: 'Obývák, ložnice, dětský pokoj i pracovna mají příjemně a na fasádě visí jediné zařízení.' },
  { img: 'hk-ms-combo', t: 'Každý pokoj podle sebe', d: 'Nástěnná, parapetní u podlahy, kazetová do podhledu nebo úplně skrytá kanálová. Jednotky libovolně kombinujete a každá má vlastní teplotu i ovladač.' },
  { img: 'hk-ms-space', t: 'Méně techniky na fasádě', d: 'Ocení to SVJ, sousedé i památkáři. Méně prostupů zdí a kratší montáž venku.' },
  { img: 'hk-ms-heat', t: 'Topí i v zimě', d: 'Venkovní jednotky mají vyhřívanou vanu a spolehlivě topí do −20 °C. V jaru a na podzim ušetříte za plyn.' },
];
---
{variant === 'teaser' ? (
  <section class="section mst" aria-labelledby="mst-h">
    <div class="wrap mst__in">
      <div class="mst__img" data-reveal="scale">
        <Img name="hk-ms-rooms" alt="Dům s pěti klimatizovanými místnostmi napojenými na jednu venkovní jednotku" sizes="(max-width: 900px) 92vw, 600px" />
        <span class="mst__badge"><b>1</b> venkovní<br />jednotka</span>
      </div>
      <div class="mst__txt" data-reveal>
        <p class="kicker">Multisplit</p>
        <h2 id="mst-h" class="display">Klimatizace do více pokojů.</h2>
        <p class="sub">Jedna venkovní jednotka zvládne až pět místností. Každý pokoj má vlastní jednotku, teplotu i ovladač. Na fasádě přitom visí jen jedno zařízení.</p>
        <ul class="mst__pts">
          <li><Icon name="home" size={22} />2 až 5 místností najednou</li>
          <li><Icon name="grid" size={22} />Nástěnné, parapetní i skryté jednotky dohromady</li>
          <li><Icon name="building" size={22} />Ideální do bytových domů, kde SVJ povolí jednu jednotku</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--sun" href="/poptavka/?typ=klimatizace-byt&mistnosti=3" data-track="cta-multisplit">Poptat více pokojů</a>
          <a class="btn btn--ghost" href="/klimatizace/multisplit/">Jak multisplit funguje</a>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="section msf" aria-labelledby="msf-h">
    <div class="wrap">
      <div class="msf__head" data-reveal>
        <p class="kicker">Jak to funguje</p>
        <h2 id="msf-h" class="display">Jedna venkovní jednotka. Až pět pokojů.</h2>
        <p class="sub">Multisplit je klimatizace pro celý byt nebo dům. Venku stojí jedna jednotka a z ní vedou rozvody do každé místnosti, kde visí vlastní vnitřní jednotka.</p>
      </div>
      <div class="msf__grid">
        {cards.map((c, i) => (
          <article class="msf__c" data-reveal data-reveal-delay={String(i % 2)}>
            <div class="msf__img"><Img name={c.img} alt={c.t} sizes="(max-width: 800px) 92vw, 580px" /></div>
            <div class="msf__body">
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="msf__how" data-reveal>
        <h3>Jak postupujeme</h3>
        <ol>
          <li><b>1</b><span><strong>Řeknete nám, které pokoje</strong>Stačí počet místností a přibližná velikost.</span></li>
          <li><b>2</b><span><strong>Technik navrhne sestavu</strong>Vybere venkovní jednotku s rezervou a typ vnitřní jednotky do každého pokoje.</span></li>
          <li><b>3</b><span><strong>Montáž obvykle za 1–2 dny</strong>Rozvody vedeme co nejkratší cestou a čistě, v lištách nebo ve zdi.</span></li>
        </ol>
        <p class="small muted">Snímky: Hisense. Multisplit montujeme od Mitsubishi Heavy Industries i Hisense. Katalogy Hisense: <a href="/ke-stazeni/hisense-multisplit.pdf" target="_blank" rel="noopener">venkovní jednotky (PDF)</a>, <a href="/ke-stazeni/hisense-multisplit-vnitrni-jednotky.pdf" target="_blank" rel="noopener">vnitřní jednotky (PDF)</a>.</p>
      </div>
    </div>
  </section>
)}

<style>
  .mst { background: var(--white); overflow: hidden; }
  .mst__in { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .mst__in > * { min-width: 0; }
  .mst__img { position: relative; border-radius: 30px; overflow: hidden; box-shadow: 0 40px 80px -50px rgba(14, 34, 51, 0.55); }
  .mst__img :global(img) { display: block; width: 100%; height: auto; }
  .mst__badge { position: absolute; right: 18px; bottom: 18px; padding: 12px 16px; border-radius: 18px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); font: 600 0.88rem/1.15 var(--font-body); color: var(--ink-soft); }
  .mst__badge b { display: block; font: 800 2rem/1 var(--font-head); color: var(--sun); }
  .mst .display { font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem); }
  .mst__pts { list-style: none; padding: 0; margin: 22px 0 28px; display: grid; gap: 12px; }
  .mst__pts li { display: flex; gap: 12px; align-items: center; font-weight: 600; }
  .mst__pts :global(.ico) { flex: none; color: var(--sun); }
  .msf__head { max-width: 760px; margin-bottom: clamp(28px, 4vw, 48px); }
  .msf__head .display { font-size: clamp(2rem, 1.3rem + 2.8vw, 3.6rem); }
  .msf__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .msf__c { border-radius: 26px; overflow: hidden; background: var(--white); box-shadow: var(--shadow); display: grid; grid-template-rows: auto 1fr; }
  .msf__img { aspect-ratio: 16 / 9; overflow: hidden; background: var(--stage); }
  .msf__img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .msf__body { padding: 22px 26px 26px; }
  .msf__body h3 { font: 700 var(--step-1)/1.2 var(--font-head); margin: 0 0 8px; }
  .msf__body p { margin: 0; color: var(--ink-soft); }
  .msf__how { margin-top: clamp(36px, 5vw, 56px); padding: clamp(24px, 4vw, 40px); border-radius: 28px; background: var(--ice); }
  .msf__how h3 { font: 700 var(--step-2)/1.1 var(--font-head); margin: 0 0 20px; }
  .msf__how ol { list-style: none; padding: 0; margin: 0 0 18px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .msf__how li { display: flex; gap: 14px; align-items: flex-start; }
  .msf__how li b { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--sun); color: #fff; font: 700 1rem/1 var(--font-head); }
  .msf__how li span { display: grid; gap: 4px; color: var(--ink-soft); }
  .msf__how li strong { color: var(--ink); }
  @media (max-width: 900px) {
    .mst__in, .msf__grid, .msf__how ol { grid-template-columns: 1fr; }
  }
</style>
