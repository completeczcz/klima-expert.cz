---
interface Props { items: { q: string; a: string }[]; title?: string; schema?: boolean }
const { items, title = 'Časté dotazy', schema = true } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
---
<div class="faq">
  {title && <h2>{title}</h2>}
  {items.map((i) => (
    <details class="faq__item">
      <summary>{i.q}</summary>
      <p set:html={i.a} />
    </details>
  ))}
  {schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</div>
<style>
  .faq { max-width: 78ch; }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__item summary { cursor: pointer; list-style: none; padding: 1.05em 2.4em 1.05em 0; position: relative; font: 600 var(--step-1)/1.3 var(--font-head); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 0.3em; top: 0.75em; font-size: 1.5em; line-height: 1; transition: transform 0.2s; }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item p { margin: 0 0 1.2em; color: var(--ink-soft); max-width: 68ch; }
</style>
