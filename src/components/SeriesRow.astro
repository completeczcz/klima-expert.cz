---
import type { Series } from '../data/products';
import { fromPrice, tierLabel, catLabel, kw } from '../data/products';
import { czk } from '../data/pricing';
interface Props { s: Series; showCat?: boolean }
const { s, showCat = false } = Astro.props;
const price = fromPrice(s);
const kws = s.models.map((m) => (s.cat === 'tepelne-cerpadlo' ? m.heatKw : m.coolKw)).filter((n): n is number => n != null);
const range = kws.length ? `${kw(Math.min(...kws))} – ${kw(Math.max(...kws))}` : s.outdoorUnits.length ? `${s.outdoorUnits[0].maxIndoor ?? 2}–${Math.max(...s.outdoorUnits.map((o) => o.maxIndoor ?? 0))} místnosti` : '';
---
<article class="sr">
  <div class="sr__main">
    <p class="sr__meta">
      <span class:list={['sr__tier', `sr__tier--${s.tier}`]}>{tierLabel[s.tier]}</span>
      <span>{s.brand}</span>
      {showCat && <span>{catLabel[s.cat]}</span>}
    </p>
    <h3><a href={`/produkty/${s.id}/`}>{s.title}</a></h3>
    <p class="sr__intro">{s.intro}</p>
  </div>
  <dl class="sr__spec">
    {range && <div><dt>Výkon</dt><dd>{range}</dd></div>}
    {s.noiseMin && s.cat !== 'tepelne-cerpadlo' && <div><dt>Hlučnost od</dt><dd>{s.noiseMin} dB(A)</dd></div>}
    {s.heatMin != null && <div><dt>Topí do</dt><dd>{String(s.heatMin).replace('-', '−')} °C</dd></div>}
    <div><dt>S montáží a DPH</dt><dd class="sr__price">{price ? `od ${czk(price)}` : 'cena na dotaz'}</dd></div>
  </dl>
  <a class="sr__link" href={`/produkty/${s.id}/`} aria-label={`Detail řady ${s.title}`}>Detail řady</a>
</article>

<style>
  .sr { display: grid; grid-template-columns: 1.5fr 1fr auto; gap: 28px; align-items: center; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .sr__meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: var(--step--1); color: var(--ink-soft); margin: 0 0 6px; }
  .sr__tier { font-weight: 700; color: var(--ink); }
  .sr__tier--premium { box-shadow: inset 0 -0.45em 0 var(--sun); }
  .sr h3 { font-size: var(--step-1); font-weight: 700; margin-bottom: 0.35em; }
  .sr h3 a { text-decoration: none; }
  .sr h3 a:hover { text-decoration: underline; text-decoration-color: var(--sun); }
  .sr__intro { color: var(--ink-soft); margin: 0; max-width: 60ch; }
  .sr__spec { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; margin: 0; font-size: var(--step--1); }
  .sr__spec dt { color: var(--ink-soft); }
  .sr__spec dd { margin: 0; font-weight: 700; }
  .sr__price { font: 700 var(--step-0)/1.2 var(--font-head) !important; }
  .sr__link { font-weight: 700; white-space: nowrap; text-decoration-color: var(--sun); text-decoration-thickness: 2px; }
  @media (max-width: 900px) { .sr { grid-template-columns: 1fr; gap: 14px; } }
</style>
