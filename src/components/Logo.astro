---
interface Props { invert?: boolean }
const { invert = false } = Astro.props;
---
<span class:list={['logo', { 'logo--invert': invert }]}>
  <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
    <path d="M20 3.5c8.6 0 16.2 5.6 16.2 15.3 0 9.4-7.8 17.7-17 17.7C10 36.5 3.8 29.6 3.8 21 3.8 11 11 3.5 20 3.5z" fill="none" stroke="currentColor" stroke-width="2.4" />
    <path d="M20.3 10c5.2 0 9.6 3.6 9.6 9.1 0 5.6-4.7 10.4-10.1 10.4-5.3 0-8.9-4-8.9-9.2 0-5.9 4.2-10.3 9.4-10.3z" fill="none" stroke="currentColor" stroke-width="2.4" opacity=".55" />
    <circle cx="20" cy="19.8" r="4.2" fill="var(--sun)" />
  </svg>
  <span class="logo__word">Klima<span>Expert</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55em; color: var(--ink); }
  .logo--invert { color: var(--paper); }
  .logo__word { font: 800 1.3rem/1 var(--font-head); letter-spacing: -0.03em; }
  .logo__word span { font-weight: 600; margin-left: 0.12em; opacity: 0.75; }
</style>
