---
import dark from '../assets/logo.svg?raw';
import light from '../assets/logo-white.svg?raw';
interface Props { invert?: boolean }
const { invert = false } = Astro.props;
---
<span class="logo" set:html={invert ? light : dark} />

<style>
  .logo { display: inline-flex; align-items: center; height: 26px; }
  .logo :global(svg) { height: 100%; width: auto; display: block; }
</style>
