---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const { dark = false } = Astro.props as { dark?: boolean };
---
<header class:list={["hdr", { "hdr--dark": dark }]}>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label={`${site.name} – úvod`}><Logo invert={dark} /></a>
    <nav class="hdr__nav" aria-label="Hlavní menu">
      {nav.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="hdr__act">
      <a class="hdr__tel" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--sun hdr__cta" href="/poptavka/" data-track="cta-header">Poptávka zdarma</a>
      <details class="hdr__menu">
        <summary aria-label="Otevřít menu"><span></span><span></span><span></span></summary>
        <div class="hdr__drawer">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="/jak-to-funguje/">Jak to funguje</a>
          <a href="/o-nas/">O nás</a>
          <a href="/kontakt/">Kontakt</a>
          <a class="btn btn--sun" href="/poptavka/">Nezávazná poptávka</a>
          <a class="hdr__drawer-tel" href={site.phoneHref}>{site.phone}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid rgba(0, 0, 0, 0.08); }
  /* Rozmazané pozadí v pseudo-prvku: backdrop-filter na samotné hlavičce by uvěznil fixed menu uvnitř 72 px vysoké lišty */
  .hdr::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(245, 245, 247, 0.86); -webkit-backdrop-filter: saturate(180%) blur(16px); backdrop-filter: saturate(180%) blur(16px); }
  .hdr__in { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .hdr__logo { text-decoration: none; flex: none; }
  .hdr__nav { display: flex; gap: 4px; margin-left: auto; }
  .hdr__nav a { white-space: nowrap; padding: 0.5em 0.7em; border-radius: 8px; text-decoration: none; font-weight: 500; font-size: 0.92rem; }
  .hdr__nav a:hover { background: var(--ice); }
  .hdr__nav a[aria-current] { box-shadow: inset 0 -3px 0 var(--sun); border-radius: 0; }
  .hdr__act { display: flex; align-items: center; gap: 14px; }
  .hdr__tel { font-weight: 700; text-decoration: none; white-space: nowrap; }
  .hdr__cta { min-height: 44px; padding: 0.55em 1.1em; font-size: 0.95rem; }
  .hdr__menu { display: none; position: relative; }
  .hdr__menu summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-content: center; gap: 5px; border-radius: 10px; }
  .hdr__menu summary::-webkit-details-marker { display: none; }
  .hdr__menu summary span { display: block; width: 22px; height: 2.5px; background: var(--ink); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .hdr__menu[open] summary span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .hdr__menu[open] summary span:nth-child(2) { opacity: 0; }
  .hdr__menu[open] summary span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }
  .hdr__drawer { position: fixed; left: 0; right: 0; top: 72px; bottom: 0; z-index: 60; height: calc(100dvh - 72px); background: var(--paper); padding: 20px var(--gutter) 40px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto; }
  .hdr__drawer a:not(.btn) { padding: 0.7em 0; font: 600 var(--step-1)/1.2 var(--font-head); text-decoration: none; border-bottom: 1px solid var(--line); }
  .hdr__drawer .btn { margin-top: 18px; }
  .hdr__drawer-tel { text-align: center; border: 0 !important; font-size: var(--step-0) !important; }
  .hdr--dark { border-bottom-color: rgba(255, 255, 255, 0.08); color: #f5f5f7; }
  .hdr--dark::before { background: rgba(11, 23, 36, 0.78); }
  .hdr--dark .hdr__nav a:hover { background: rgba(255, 255, 255, 0.08); }
  .hdr--dark .hdr__tel { color: #fff; }
  .hdr--dark .hdr__menu summary span { background: #fff; }
  .hdr--dark .hdr__drawer { color: var(--ink); }
  @media (max-width: 1240px) { .hdr__tel { display: none; } }
  @media (max-width: 980px) {
    .hdr__nav { display: none; }
    .hdr__menu { display: block; }
    .hdr__act { margin-left: auto; }
  }
  @media (max-width: 460px) { .hdr__cta { display: none; } }
</style>
