---
import Img from './Img.astro';
import Icon from './Icon.astro';
---
<section class="section ap" aria-labelledby="ap-h" style="background:#fff">
  <div class="wrap ap__in">
    <div class="ap__phone" data-reveal="scale"><Img name="his-pxw-wifi-control" alt="Ovládání klimatizace z mobilního telefonu" sizes="(max-width: 860px) 92vw, 620px" /></div>
    <div data-reveal data-reveal-delay="1">
      <p class="kicker">Chytré ovládání</p>
      <h2 id="ap-h" class="display">Doma bude chladno dřív, než dorazíte.</h2>
      <p class="sub">Většinu jednotek ovládáte z mobilu přes Wi-Fi. Zapnete ji cestou z práce, nastavíte týdenní program a na chalupě udržíte temperování.</p>
      <div class="feats ap__feats">
        <div class="feat"><Icon name="wifi" /><strong>Wi-Fi</strong><span>Ovládání odkudkoli</span></div>
        <div class="feat"><Icon name="calendar" /><strong>Týdenní program</strong><span>Topí a chladí podle vás</span></div>
        <div class="feat"><Icon name="chat" /><strong>Hlasové ovládání</strong><span>U vybraných řad Hisense</span></div>
      </div>
    </div>
  </div>
</section>
<style>
  .ap__in { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .ap__phone { width: 100%; border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow); }
  .ap__phone :global(img) { width: 100%; height: auto; display: block; }
  .ap__feats { margin-top: 28px; }
  @media (max-width: 860px) { .ap__in { grid-template-columns: 1fr; } .ap__phone { width: 100%; } }
</style>
